    {
      "name": "Questionário CARAT",
      "item": [
        {
          "name": "POST Submeter CARAT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 - Avaliação submetida com sucesso\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta contém a mensagem de sucesso correta\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.mensagem).to.eql(\"Avaliação CARAT submetida e processada com sucesso!\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Avaliação contém os scores calculados pelo sistema\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    // Verifica se o objeto \"avaliacao\" existe\r",
                  "    pm.expect(jsonData).to.have.property(\"avaliacao\");\r",
                  "    \r",
                  "    // Verifica se a plataforma fez os calculos corretamente\r",
                  "    pm.expect(jsonData.avaliacao).to.have.property(\"scoreTotal\");\r",
                  "    pm.expect(jsonData.avaliacao).to.have.property(\"nivelControlo\");\r",
                  "    pm.expect(jsonData.avaliacao).to.have.property(\"scoreViasSuperiores\");\r",
                  "    pm.expect(jsonData.avaliacao).to.have.property(\"scoreViasInferiores\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
